{
  "name": "fetchpier",
  "productName": "Fetchpier",
  "version": "0.9.7",
  "description": "Open-source desktop API client with filesystem-based workspaces and Git-friendly collections.",
  "author": "Daniel Monza",
  "license": "MIT",
  "homepage": "https://fetchpier.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmonza/fetchpier.git"
  },
  "bugs": {
    "url": "https://github.com/dmonza/fetchpier/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "keywords": [
    "api-client",
    "rest-client",
    "http-client",
    "postman-alternative",
    "electron",
    "desktop",
    "open-source",
    "git-friendly"
  ],
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run build:core && concurrently --kill-others -n core,app -c blue,green \"npm:dev:core\" \"npm:dev:app\"",
    "dev:app": "electron-vite dev",
    "dev:core": "npm run dev --workspace @fetchpier/core",
    "build:core": "npm run build --workspace @fetchpier/core",
    "build:cli": "npm run build --workspace @fetchpier/cli",
    "dev:cli": "npm run dev --workspace @fetchpier/cli",
    "dev:renderer": "electron-vite dev --mode=development",
    "generate:licenses": "generate-license-file --input ./package.json --output ./THIRD_PARTY_LICENSES.txt --overwrite",
    "check:licenses": "node scripts/check-license-file.mjs",
    "generate:fp-dts": "node scripts/generate-fp-dts.mjs",
    "prebuild:dts": "node scripts/generate-fp-dts.mjs --check",
    "prebuild": "npm run generate:licenses && npm run prebuild:dts",
    "build": "npm run build:core && electron-vite build",
    "postbuild": "npm run audit:network && npm run audit:coldpath && npm run audit:maincoldpath",
    "preview": "npx electron-vite preview",
    "audit:network": "node scripts/audit/network-egress-bundle.mjs",
    "audit:coldpath": "node scripts/audit/cold-path-bundle.mjs",
    "audit:maincoldpath": "node scripts/audit/main-cold-path.mjs",
    "audit:atomicwrites": "node scripts/audit/atomic-write-audit.mjs",
    "audit:deadcode": "knip",
    "audit:shipped": "node scripts/audit/shipped-runtime.mjs",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p packages/fetchpier-core/tsconfig.json && tsc --noEmit -p packages/fetchpier-cli/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:main": "vitest run --project main",
    "test:shared": "vitest run --project shared",
    "test:renderer": "vitest run --project renderer",
    "test:core": "vitest run --project core",
    "test:cli": "vitest run --project cli",
    "test:e2e-helpers": "vitest run --project e2e-helpers",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test smoke.spec.ts ui-state.spec.ts",
    "test:e2e": "playwright test",
    "post-req": "node scripts/post-req.mjs",
    "preflight": "node scripts/preflight.mjs",
    "perf:memory": "node scripts/perf/electron-memory.bench.mjs",
    "perf:memory:report": "node scripts/perf/electron-memory.report.mjs",
    "perf:startup": "node scripts/perf/electron-startup.bench.mjs",
    "perf:startup:report": "node scripts/perf/electron-startup.report.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fetchpier/core": "*",
    "@radix-ui/react-slot": "^1.5.0",
    "@readme/openapi-parser": "^6.3.0",
    "@typescript/vfs": "^1.6.5",
    "@uiw/codemirror-theme-dracula": "^4.25.12",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@valtown/codemirror-ts": "^2.3.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "graphql": "^16.14.0",
    "i18next": "^26.5.10",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.61.0",
    "mime": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-resizable-panels": "^4.15.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.3",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1"
    },
    "@electron/get": {
      "undici": "7.30.1"
    },
    "@apidevtools/json-schema-ref-parser": {
      "undici": "6.29.1",
      "js-yaml": "5.5.0"
    },
    "fast-uri": "3.1.9"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "generate-license-file": "^4.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^5.66.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
