{
  "info": {
    "_postman_id": "basic-collection-uuid",
    "name": "RESTful API Basics #blueprint",
    "description": "Sample collection to illustrate a simple REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}info?id={{id}}",
          "host": ["{{base_url}}info"],
          "query": [
            { "key": "id", "value": "{{id}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Post data",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Add your name in the body\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}info",
          "host": ["{{base_url}}info"]
        }
      },
      "response": []
    },
    {
      "name": "Update data",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated name\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}info?id={{id}}",
          "host": ["{{base_url}}info"],
          "query": [
            { "key": "id", "value": "{{id}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete data",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}info?id={{id}}",
          "host": ["{{base_url}}info"],
          "query": [
            { "key": "id", "value": "{{id}}" }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://postman-rest-api-learner.glitch.me/" },
    { "key": "id", "value": "1" }
  ]
}
