{
  "info": {
    "name": "V2 Zero",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "alice" },
      { "key": "password", "value": "wonder" }
    ]
  },
  "item": [
    {
      "name": "Ping",
      "request": "https://api.example.com/ping"
    },
    {
      "name": "Echo",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "hello"
        },
        "url": "https://api.example.com/echo"
      }
    }
  ]
}
