{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared/*": ["../../src/shared/*"],
      // Reached through `@shared/lib/activity-log` (imported by a core test).
      // Left unmapped it resolves via the package `exports` to the gitignored
      // `dist/` and typecheck fails on a fresh clone (CI). See tsconfig.node.json.
      "@fetchpier/core/activity-log": ["./src/activity-log/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"]
}
